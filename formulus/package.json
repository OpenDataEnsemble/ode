{
  "name": "formulus-app",
  "version": "1.3.1",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "preandroid": "pnpm run vendor:notifee && pnpm run patch:android-foss",
    "postinstall": "node scripts/patch-android-foss.mjs",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --max-warnings 9999",
    "lint:fix": "eslint . --fix --max-warnings 9999",
    "format": "pnpm exec prettier \"**/*.{js,jsx,ts,tsx,json,css,md}\" --write",
    "format:check": "pnpm exec prettier \"**/*.{js,jsx,ts,tsx,json,css,md}\" --check",
    "start": "react-native start",
    "test": "jest",
    "generate": "tsx scripts/generateInjectionScript.ts",
    "generate:api": "pnpm dlx @openapitools/openapi-generator-cli generate -i ../synkronus/openapi/synkronus.yaml -g typescript-axios -o src/api/synkronus/generated \"--additional-properties=supportsES6=true,useSingleRequestParameter=true,modelPropertyNaming=original\" && pnpm run format",
    "generate_qr": "tsx scripts/generateQR.ts",
    "sync:version": "node scripts/syncNativeVersion.js",
    "validate:native-versions": "node scripts/validateNativeVersions.js",
    "vendor:notifee": "node scripts/vendor-notifee-core.mjs",
    "patch:android-foss": "node scripts/patch-android-foss.mjs",
    "prebuild": "pnpm run sync:version && pnpm run generate"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@nozbe/simdjson": "3.9.4",
    "@nozbe/sqlite": "3.46.0",
    "@nozbe/watermelondb": "^0.28.0",
    "@ode/components": "file:..\\packages\\components",
    "@ode/observation-query": "file:..\\packages\\observation-query",
    "@ode/tokens": "file:..\\packages\\tokens",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-documents/picker": "^12.0.2",
    "@react-native-vector-icons/fontawesome6": "^12.4.0",
    "@react-native-vector-icons/material-design-icons": "^12.5.0",
    "@react-native-vector-icons/material-icons": "^12.5.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/stack": "^7.10.23",
    "axios": "^1.16.1",
    "buffer": "^6.0.3",
    "hermes-compiler": "0.14.0",
    "i18next": "^26.4.0",
    "lucide-react-native": "^0.577.0",
    "react": "19.2.4",
    "react-i18next": "^17.0.12",
    "react-native": "0.83.1",
    "react-native-camera-kit-no-google": "^17.0.4",
    "react-native-device-info": "^15.0.2",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-localize": "^3.7.0",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-nitro-sound": "^0.2.19",
    "react-native-permissions": "^5.6.1",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "4.25.2",
    "react-native-signature-canvas": "^5.1.1",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "^13.17.0",
    "react-native-zip-archive": "^7.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/codegen": "0.83.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/gradle-plugin": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "baseline-browser-mapping": "^2.11.18",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.5.0",
    "jest": "30.3.0",
    "prettier": "3.8.1",
    "react-test-renderer": "19.2.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20"
  }
}
