# Server settings
PORT=8080

# Database settings
DB_CONNECTION=postgres://user:password@localhost:5432/synkronus

# Authentication
JWT_SECRET=your-secret-key-here
# Bootstrap admin credentials (used only when no users exist)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
#
# Recovery admin credentials (optional):
# If both are set, Synkronus will create/update this user as admin on startup.
# Remove them after recovery to avoid repeated password resets on restart.
# SYNKRONUS_RECOVERY_CREATE_USER=admin
# SYNKRONUS_RECOVERY_CREATE_PASS=temporary-strong-password

# Logging
LOG_LEVEL=debug

MAX_VERSIONS_KEPT=5
