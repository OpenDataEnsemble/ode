# Server settings
PORT=8080

# Database settings
DB_CONNECTION=postgres://user:password@localhost:5432/synkronus

# Authentication
JWT_SECRET=your-secret-key-here
# Bootstrap admin credentials (used only when no users exist)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
#
# Recovery admin credentials (optional):
# If both are set, Synkronus will create/update this user as admin on startup.
# Remove them after recovery to avoid repeated password resets on restart.
# SYNKRONUS_RECOVERY_CREATE_USER=admin
# SYNKRONUS_RECOVERY_CREATE_PASS=temporary-strong-password

# Logging
LOG_LEVEL=debug

MAX_VERSIONS_KEPT=5

# Optional attachment image processing for uploaded photos.
# The default sync/download path serves files from data/attachments/.
# If processing creates a smaller image, Synkronus keeps the uploaded original at
# data/attachments_uncompressed/ and clients can request it with ?original=true.
#
# Compression level:
#   0  = disabled (pass-through unless resize/orientation still applies)
#   1-10 = increasingly stronger compression for supported image formats
SYNKRONUS_IMAGE_COMPRESSION_LEVEL=0
# Downscale images to fit within this box (preserve aspect ratio, never upscale).
# Set axis to 0 to disable that axis limit.
SYNKRONUS_IMAGE_MAX_WIDTH_PX=0
SYNKRONUS_IMAGE_MAX_HEIGHT_PX=0
# Normalize EXIF orientation before resize/compression (recommended for phone JPEGs).
SYNKRONUS_IMAGE_APPLY_EXIF_ORIENTATION=true
